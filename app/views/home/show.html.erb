<div class="flex flex-col items-center text-center">
  <%= render 'shared/lotus', class: 'size-24 lg:size-28 rounded-3xl shadow-lg shadow-primary/20' %>
  <h1 class="mt-8"><%= render 'shared/wordmark', class: 'text-7xl lg:text-8xl' %></h1>

  <div class="mt-12 w-full max-w-xs">
    <% if user_signed_in? %>
      <%= button_to 'Sign out', destroy_user_session_path, method: :delete,
          class: 'btn btn-outline btn-primary rounded-2xl w-full', form_class: 'w-full' %>
    <% else %>
      <%= link_to 'Sign in', new_user_session_path, class: 'btn btn-primary rounded-2xl w-full' %>
    <% end %>
  </div>
</div>
