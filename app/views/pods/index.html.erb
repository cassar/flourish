<%= render 'shared/app_header' %>

<div class="w-full max-w-md">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-semibold">Pods</h1>
    <%= link_to 'New pod', new_pod_path, class: 'btn btn-primary btn-sm rounded-xl' %>
  </div>

  <% if @pods.empty? %>
    <p class="bg-base-200 rounded-3xl p-8 text-center text-base-content/60">No pods yet.</p>
  <% else %>
    <ul class="bg-base-200 rounded-3xl divide-y divide-base-300">
      <% @pods.each do |pod| %>
        <li class="flex items-center gap-3 px-6 py-4">
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate"><%= pod.name %></p>
            <p class="text-sm text-base-content/60"><%= pluralize(pod.people_count, 'person', plural: 'people') %></p>
          </div>
          <%= link_to 'Edit', edit_pod_path(pod), class: 'btn btn-ghost btn-sm rounded-xl' %>
          <%= button_to 'Delete', pod_path(pod), method: :delete,
              class: 'btn btn-ghost btn-sm rounded-xl text-error',
              form: { data: { turbo_confirm: "Delete #{pod.name}?" } } %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
