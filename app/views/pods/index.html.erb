<%= render 'shared/app_header' %>

<div class="w-full max-w-md">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-semibold">Pods</h1>
    <%= button_to 'New pod', pods_path, class: 'btn btn-primary btn-sm rounded-xl' %>
  </div>

  <% if @pods.empty? %>
    <p class="bg-base-200 rounded-3xl p-8 text-center text-base-content/60">No pods yet.</p>
  <% else %>
    <div class="grid grid-cols-2 gap-3">
      <% @pods.each do |pod| %>
        <article class="card bg-base-200 rounded-3xl">
          <div class="card-body p-5 gap-1">
            <h2 class="card-title text-lg">Pod <%= pod.id %></h2>
            <p class="text-sm text-base-content/60"><%= pluralize(pod.people_count, 'person', plural: 'people') %></p>
            <% if pod.id.in?(@contributor_pod_ids) %>
              <div class="card-actions justify-end mt-2">
                <%= button_to 'Delete', pod_path(pod), method: :delete,
                    class: 'btn btn-ghost btn-xs rounded-lg text-error',
                    form: { data: { turbo_confirm: "Delete Pod #{pod.id}?" } } %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
