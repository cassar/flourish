<%= render 'shared/app_header' %>

<div class="w-full max-w-md sm:max-w-3xl lg:max-w-5xl">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-semibold">Pods</h1>
    <%= button_to 'New pod', pods_path, class: 'btn btn-primary btn-sm rounded-xl' %>
  </div>

  <% if @pods.empty? %>
    <p class="bg-base-200 rounded-3xl p-8 text-center text-base-content/60">No pods yet.</p>
  <% else %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 lg:gap-4">
      <% @pods.each do |pod| %>
        <article class="card bg-base-200 rounded-3xl relative">
          <% if pod.id.in?(@contributor_pod_ids) %>
            <%= button_to pod_path(pod), method: :delete,
                class: 'btn btn-ghost btn-circle btn-xs text-base-content/40 hover:text-error',
                form_class: 'absolute top-3 right-3',
                aria: { label: "Delete Pod #{pod.id}" },
                form: { data: { turbo_confirm: "Delete Pod #{pod.id}?" } } do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="size-3.5" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            <% end %>
          <% end %>
          <div class="card-body p-5 gap-2 items-center text-center">
            <h2 class="card-title text-lg">Pod <%= pod.id %></h2>
            <%= render 'shared/plant', class: 'size-16 my-1' %>
            <p class="text-sm text-base-content/60"><%= pluralize(pod.people_count, 'person', plural: 'people') %></p>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
