<%= render 'shared/app_header' %>

<div class="w-full max-w-md sm:max-w-3xl lg:max-w-5xl">
  <%= link_to pods_path, class: 'btn btn-ghost btn-sm rounded-xl -ml-3 mb-4' do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" />
    </svg>
    Pods
  <% end %>

  <div class="grid gap-6 lg:grid-cols-[20rem_1fr] lg:items-start">
    <section class="bg-base-200 rounded-3xl p-8 flex flex-col items-center text-center">
      <h1 class="text-2xl font-semibold">Pod <%= @pod.id %></h1>
      <%= render 'shared/plant', class: 'size-24 my-4' %>
      <p class="text-sm text-base-content/60"><%= pluralize(@memberships.size, 'person', plural: 'people') %></p>
    </section>

    <section>
      <h2 class="text-xs uppercase tracking-widest text-base-content/50 font-medium mb-3 px-2">People</h2>
      <ul class="bg-base-200 rounded-3xl divide-y divide-base-300">
        <% @memberships.each do |membership| %>
          <li class="flex items-center gap-3 px-6 py-3">
            <span class="flex-1 truncate">
              <%= membership.member.display_name %>
              <% if membership.member == current_user.member %>
                <span class="text-base-content/50">(you)</span>
              <% end %>
            </span>
            <% if membership.contributor? %>
              <span class="badge badge-primary badge-sm">Contributor</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</div>
