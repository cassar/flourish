<%= render 'shared/app_header' %>

<div class="w-full max-w-md sm:max-w-3xl lg:max-w-5xl">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-semibold">Pots</h1>
    <%= button_to 'New pot', pots_path, class: 'btn btn-primary btn-sm rounded-xl' %>
  </div>

  <% if @pots.empty? %>
    <p class="bg-base-200 rounded-3xl p-8 text-center text-base-content/60">No pots yet.</p>
  <% else %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 lg:gap-4">
      <% @pots.each do |pot| %>
        <article class="card bg-base-200 rounded-3xl relative transition hover:bg-base-300/60">
          <div class="card-body p-5 gap-2 items-center text-center">
            <h2 class="card-title text-lg">
              <%= link_to "Pot #{pot.id}", pot_path(pot), class: 'after:absolute after:inset-0 after:rounded-3xl' %>
            </h2>
            <%= render 'shared/plant', class: 'size-16 my-1' %>
            <p class="text-sm text-base-content/60"><%= pluralize(pot.people_count, 'person', plural: 'people') %></p>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
