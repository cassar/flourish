<%= render 'shared/app_header' %>

<%
  # The contributor sits in the centre of the square stage; everyone else is
  # placed evenly on a circle around them (percentages of the stage). Larger
  # pots alternate between two rings so neighbouring boxes don't collide.
  count = @memberships.size
  contributor, *others = @memberships
  large = others.size > 10
  positions = others.each_with_index.map do |_, i|
    angle = (-90 + (360.0 * i / others.size)) * Math::PI / 180
    radius = large && i.odd? ? 29 : 41
    [(50 + (radius * Math.cos(angle))).round(2), (50 + (radius * Math.sin(angle))).round(2)]
  end
%>

<div class="relative w-full max-w-md sm:max-w-3xl lg:max-w-5xl">
  <%= link_to pots_path, class: 'btn btn-ghost btn-sm rounded-xl -ml-3 mb-4' do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" />
    </svg>
    Pots
  <% end %>

  <h1 class="text-2xl font-semibold mb-6 sm:mb-0 sm:absolute sm:left-0 sm:top-12">Pot <%= @pot.id %></h1>

  <div class="flex flex-wrap items-center justify-center gap-2 sm:block sm:relative sm:aspect-square sm:mx-auto <%= large ? 'sm:max-w-3xl' : 'sm:max-w-2xl' %>">
    <svg viewBox="0 0 100 100" class="hidden sm:block absolute inset-0 size-full" aria-hidden="true">
      <% positions.each do |x, y| %>
        <line x1="50" y1="50" x2="<%= x %>" y2="<%= y %>" class="stroke-base-300" stroke-width="0.4" />
      <% end %>
    </svg>

    <section class="w-full mb-4 sm:mb-0 sm:w-52 sm:absolute sm:left-1/2 sm:top-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 bg-base-200 rounded-3xl p-6 flex flex-col items-center text-center shadow-sm">
      <div data-person class="rounded-2xl px-4 py-2 whitespace-nowrap shadow-sm bg-primary text-primary-content">
        <p class="font-medium text-sm"><%= contributor.member.display_name %></p>
        <p class="text-[0.65rem] uppercase tracking-widest opacity-75">Contributor</p>
      </div>
      <%= render 'shared/plant', class: 'size-20 my-3' %>
      <p class="text-sm text-base-content/60"><%= pluralize(count, 'person', plural: 'people') %></p>
    </section>

    <% others.zip(positions).each do |membership, (x, y)| %>
      <div data-person style="--x: <%= x %>%; --y: <%= y %>%"
           class="sm:absolute sm:left-(--x) sm:top-(--y) sm:-translate-x-1/2 sm:-translate-y-1/2 rounded-2xl text-center whitespace-nowrap shadow-sm bg-base-200 <%= large ? 'px-3 py-1.5 lg:px-4 lg:py-2' : 'px-4 py-2' %>">
        <p class="font-medium <%= large ? 'text-xs lg:text-sm' : 'text-sm' %>">
          <%= membership.member.display_name %>
        </p>
      </div>
    <% end %>
  </div>

  <section class="mt-12">
    <h2 class="text-xs uppercase tracking-widest text-base-content/50 font-medium mb-3 px-2">Distributions</h2>
    <% if @distributions.empty? %>
      <p class="bg-base-200 rounded-3xl p-6 text-center text-sm text-base-content/60">No distributions yet.</p>
    <% else %>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
        <% @distributions.each do |distribution| %>
          <%= link_to pot_distribution_path(@pot, distribution), data: { distribution: true },
              class: 'block bg-base-200 rounded-2xl px-4 py-5 text-center transition hover:bg-base-300/60' do %>
            <p class="text-lg font-semibold tabular-nums">
              <%= distribution.amount.format(with_currency: false) %>
              <span class="text-xs font-normal text-base-content/50">AUD</span>
            </p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
