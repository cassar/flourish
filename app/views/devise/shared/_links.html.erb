<div class="mt-8 pt-6 border-t border-base-200 text-sm text-center space-y-2">
  <% if controller_name != 'sessions' %>
    <p><%= link_to 'Sign in', new_session_path(resource_name), class: 'link link-hover text-base-content/60' %></p>
  <% end %>
  <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
    <p><%= link_to 'Forgot your password?', new_password_path(resource_name), class: 'link link-hover text-base-content/60' %></p>
  <% end %>
  <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: 'link link-hover text-base-content/60' %></p>
  <% end %>
</div>
