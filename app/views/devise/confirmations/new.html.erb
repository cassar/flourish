<% content_for :card do %>
  <%= form_with(model: resource, as: resource_name, url: confirmation_path(resource_name), method: :post, class: 'space-y-5') do |f| %>
    <%= render 'devise/shared/error_messages', resource: %>

    <fieldset class="fieldset">
      <%= f.label :email, 'Email', class: 'fieldset-legend text-xs uppercase tracking-widest text-base-content/50' %>
      <%= f.email_field :email, autofocus: true, autocomplete: 'email',
          value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
          class: 'input w-full rounded-xl' %>
    </fieldset>

    <%= f.submit 'Resend confirmation instructions', class: 'btn btn-primary rounded-2xl w-full' %>
  <% end %>
<% end %>

<%= render 'devise/shared/card' %>
