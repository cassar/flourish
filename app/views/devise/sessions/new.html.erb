<div class="w-full max-w-sm">
  <%= render 'devise/shared/header' %>

  <div class="bg-base-200 rounded-3xl p-8">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'space-y-5' }) do |f| %>
      <fieldset class="fieldset">
        <%= f.label :email, 'Email', class: 'fieldset-legend text-xs uppercase tracking-widest text-base-content/50' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'input w-full rounded-xl' %>
      </fieldset>

      <fieldset class="fieldset">
        <%= f.label :password, 'Password', class: 'fieldset-legend text-xs uppercase tracking-widest text-base-content/50' %>
        <%= f.password_field :password, autocomplete: 'current-password', class: 'input w-full rounded-xl' %>
      </fieldset>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-3 cursor-pointer text-sm text-base-content/60">
          <%= f.check_box :remember_me, class: 'checkbox checkbox-primary checkbox-sm' %>
          Stay signed in
        </label>
      <% end %>

      <%= f.submit 'Sign in', class: 'btn btn-primary rounded-2xl w-full' %>
    <% end %>

    <%= render 'devise/shared/links' %>
  </div>
</div>
