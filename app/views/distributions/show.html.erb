<%= render 'shared/app_header' %>

<div class="w-full max-w-md sm:max-w-3xl lg:max-w-5xl">
  <%= link_to pod_path(@pod), class: 'btn btn-ghost btn-sm rounded-xl -ml-3 mb-4' do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" />
    </svg>
    Pod <%= @pod.id %>
  <% end %>

  <section class="bg-base-200 rounded-3xl p-8 sm:p-10 flex flex-col items-center text-center max-w-md mx-auto">
    <h1 class="text-sm uppercase tracking-widest text-base-content/50 font-medium">Distribution <%= @distribution.name %></h1>
    <p class="mt-4 text-5xl font-semibold tabular-nums text-primary">
      <%= @distribution.amount.format(with_currency: false) %>
    </p>
    <p class="mt-1 text-xs text-base-content/50">AUD</p>
    <p class="mt-4 text-sm text-base-content/60"><%= @distribution.date_formatted %></p>
  </section>

  <section class="mt-10 max-w-md mx-auto">
    <h2 class="text-xs uppercase tracking-widest text-base-content/50 font-medium mb-3 text-center">Paid to</h2>
    <% if @dividends.empty? %>
      <p class="bg-base-200 rounded-3xl p-6 text-center text-sm text-base-content/60">No one was paid from this distribution.</p>
    <% else %>
      <div class="flex flex-wrap justify-center gap-2">
        <% @dividends.each do |dividend| %>
          <div data-recipient class="bg-base-200 rounded-2xl px-4 py-2 text-center shadow-sm">
            <p class="text-sm font-medium flex items-center justify-center gap-2">
              <%= dividend.member&.display_name || 'Former member' %>
              <% if dividend.pending_pay_out? %>
                <span class="badge badge-warning badge-sm">Pending</span>
              <% end %>
            </p>
            <p class="text-xs text-base-content/60 tabular-nums"><%= (dividend.pay_out || dividend.amount).amount_formatted %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
