<!DOCTYPE html>
<html>
  <head>
    <title>Flourish</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/png" href="<%= asset_path 'favicon/favicon-96x96.png' %>" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="<%= asset_path 'favicon/favicon.svg' %>">
    <link rel="shortcut icon" href="<%= asset_path 'favicon/favicon.ico' %>">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path 'favicon/apple-touch-icon.png' %>">
    <meta name="apple-mobile-web-app-title" content="Flourish">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="bg-base-100 text-base-content">
    <main class="min-h-screen flex flex-col items-center <%= content_for?(:top_aligned) ? 'justify-start' : 'justify-center' %> px-4 py-10">
      <%= render 'shared/flash' %>
      <%= yield %>
    </main>
    <%= render 'shared/confirm_dialog' %>
  </body>
</html>
