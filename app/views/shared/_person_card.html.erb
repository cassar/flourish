<div data-<%= data_attribute %> class="bg-base-200 rounded-2xl px-4 py-2 text-center shadow-sm">
  <p class="text-sm font-medium<%= ' flex items-center justify-center gap-2' if flex %>">
    <%= name %>
    <% if badge %>
      <span class="badge badge-warning badge-sm"><%= badge %></span>
    <% end %>
  </p>
  <p class="text-xs text-base-content/60 tabular-nums"><%= amount %></p>
</div>
