<% content_for :top_aligned, true %>
<header class="w-full max-w-md flex items-center justify-between mb-8">
  <%= link_to root_path, class: 'flex items-center gap-3', aria: { label: 'Flourish home' } do %>
    <%= render 'shared/lotus', class: 'size-9 rounded-xl shadow-sm shadow-primary/20' %>
    <%= render 'shared/wordmark', class: 'text-2xl' %>
  <% end %>
  <%= button_to 'Sign out', destroy_user_session_path, method: :delete, class: 'btn btn-ghost btn-sm rounded-xl' %>
</header>
