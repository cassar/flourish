#!/bin/sh
set -e

case "$KAMAL_DESTINATION" in
    home) SSH_KEY="$HOME/.ssh/home-server" ;;
    *) SSH_KEY="$HOME/.ssh/cassar-code.pem" ;;
esac
SSH_OPTS="-i $SSH_KEY -o StrictHostKeyChecking=accept-new"

for host in $(echo "$KAMAL_HOSTS" | tr ',' ' '); do
    # Signal to the systemd prune timer that a deployment is in progress
    # (no-op on hosts without that timer, e.g. the home server destination)
    ssh $SSH_OPTS "ubuntu@$host" "touch /tmp/kamal-deploying" || true
done
